# Salin ke .env.local lalu isi sesuai kebutuhan. Jangan commit .env.local.

# Database PostgreSQL.
# - Kosong: memakai PostgreSQL lokal (PGlite) di folder .data/ — cocok untuk pengembangan.
# - Supabase: Project Settings → Database → Connection string → "Transaction pooler"
#   (port 6543), contoh: postgresql://postgres.<ref>:<password>@<host>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Alamat publik aplikasi, dipakai untuk link invoice di pesan WhatsApp, metadata, dan sitemap.
APP_URL=http://localhost:3000

# Provider WhatsApp: "log" (default, hanya dicatat di log server — pesan tidak terkirim).
WHATSAPP_PROVIDER=log

# Rahasia untuk endpoint cron (/api/cron/*). Kirim sebagai header "Authorization: Bearer <CRON_SECRET>".
# Buat string acak panjang, mis. `openssl rand -hex 32`.
CRON_SECRET=

# Webhook WhatsApp masuk (/api/webhook/whatsapp):
# - WHATSAPP_WEBHOOK_SECRET: kunci HMAC (App Secret Meta, atau HMAC key webhook WAHA).
# - WHATSAPP_VERIFY_TOKEN: token verifikasi langganan webhook Meta.
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Provider WAHA (WHATSAPP_PROVIDER=waha) untuk sandbox/pilot.
WAHA_URL=
WAHA_API_KEY=
WAHA_SESSION=default
# Opsional selama uji coba: hanya kirim ke nomor ini (dipisah koma, mis. 6281234567890).
WHATSAPP_NOMOR_UJI=

# Parser pesan Kosta (API gaya OpenAI, mis. OpenRouter / model gateway). Kosongkan LLM_API_KEY
# untuk memakai parser kata kunci saja.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-5.4-mini

# Payment gateway Xendit (Payments API + xenPlatform). Secret key dari Dashboard → Settings → API Keys:
# xnd_development_… = mode test, xnd_production_… = uang sungguhan. Kosong = mode contoh (VA/QR palsu).
# Uang penyewa masuk ke sub-akun xenPlatform tiap kos (diatur platform admin di /platform), bukan ke
# akun Kostera. Token webhook dari Settings → Webhooks → "Webhook verification token"; URL webhook
# pembayaran: APP_URL + /api/webhook/pembayaran/xendit.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# WhatsApp Cloud API (Meta, resmi) untuk produksi: WHATSAPP_PROVIDER=meta.
# Token akses (System User) & Phone Number ID dari WhatsApp Manager. Template pengingat yang harus
# didaftarkan ada di src/lib/pesan.ts (TEMPLATE_PENGINGAT).
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
# Opsional, bawaan v23.0.
META_WA_API_VERSION=

# Better Auth (login nomor WhatsApp + OTP). Rahasia acak ≥ 32 karakter, mis. hasil: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Alamat aplikasi untuk Better Auth; bila kosong memakai APP_URL.
BETTER_AUTH_URL=

# WAHA (pilot/sandbox): tanpa WHATSAPP_NOMOR_UJI semua kiriman WAHA DITAHAN.
# Isi true HANYA kalau memang sengaja mengizinkan kirim ke semua nomor (bukan untuk dev/test).
WAHA_IZINKAN_SEMUA_NOMOR=false

# Domain landing (mis. https://kostera.id). Bila diisi bersama APP_URL (mis. https://app.kostera.id),
# domain landing hanya menampilkan landing dan halaman aplikasi diteruskan ke APP_URL. Dibaca saat build.
LANDING_URL=

# WhatsApp Business Account ID — hanya untuk mendaftarkan/mengecek template (npm run meta:template).
META_WABA_ID=

# Mode pilot internal: "pilot" = boleh WHATSAPP_PROVIDER=waha (wajib WHATSAPP_NOMOR_UJI, WAHA_API_KEY,
# WAHA_URL https). Kosongkan untuk produksi penuh (wajib Meta). Dipakai npm run cek:produksi.
KOSTERA_MODE=
