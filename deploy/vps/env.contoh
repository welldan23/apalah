# Contoh isi deploy/vps/.env. pasang.sh menyalinnya otomatis saat pertama dipasang dan mengisi
# POSTGRES_PASSWORD & BETTER_AUTH_SECRET dengan nilai acak. File .env itu JANGAN di-commit/dibagikan.
# Setelah mengubah .env, jalankan lagi: bash deploy/vps/pasang.sh

# Domain (tanpa https://). Landing di domain utama, aplikasi di subdomain.
KOSTERA_DOMAIN_LANDING=kostera.id
KOSTERA_DOMAIN_APP=app.kostera.id

# Diisi acak otomatis oleh pasang.sh — jangan diubah setelah database terisi.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# --- Tahap 2: WhatsApp (pilih salah satu, lihat docs/deploy-produksi.md) ---
# Meta WhatsApp Cloud API (produksi):
# WHATSAPP_PROVIDER=meta
# META_WA_TOKEN=
# META_WA_PHONE_NUMBER_ID=
# META_WABA_ID=
# WHATSAPP_WEBHOOK_SECRET=
# WHATSAPP_VERIFY_TOKEN=
#
# Pilot WAHA (khusus nomor owner uji coba):
# KOSTERA_MODE=pilot
# WHATSAPP_PROVIDER=waha
# WAHA_URL=
# WAHA_API_KEY=
# WAHA_SESSION=default
# WHATSAPP_NOMOR_UJI=
# WHATSAPP_WEBHOOK_SECRET=

# --- Tahap 3: Xendit (mulai dari kunci test xnd_development_…) ---
# XENDIT_SECRET_KEY=
# XENDIT_WEBHOOK_TOKEN=

# --- Tahap 4: jadwal otomatis (isi setelah WhatsApp & pembayaran terverifikasi) ---
# Acak ≥ 32 karakter, mis. hasil: head -c 32 /dev/urandom | base64
# CRON_SECRET=

# --- Opsional: Kosta AI pakai LLM (tanpa ini memakai parser kata kunci) ---
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
